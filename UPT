local function tryBuyUpgrades()
   for _, obj in ipairs(workspace:GetDescendants()) do
      pcall(function()
         if not obj or not obj.Parent then return end
         local lname  = string.lower(obj.Name)
         local lparent = string.lower(obj.Parent and obj.Parent.Name or "")
         if (obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector")) and (
            string.find(lname,  "buy") or
            string.find(lname,  "upgrade") or
            string.find(lparent,"upgrade")
         ) then
            if obj:IsA("ProximityPrompt") then
               fireproximityprompt(obj)
            elseif obj:IsA("ClickDetector") then
               fireclickdetector(obj)
            end
         end
      end)
   end
end

