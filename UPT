-- ── Direct Cash Collection (no teleport needed) ───────────────────────────────
local function collectCashDirect()
   local hrp = character and character:FindFirstChild("HumanoidRootPart")
   if not hrp then return end

   for _, obj in ipairs(workspace:GetDescendants()) do
      pcall(function()
         if not obj or not obj.Parent then return end
         local lower = string.lower(obj.Name)
         if obj:IsA("BasePart") and (
            string.find(lower, "cash") or
            string.find(lower, "money") or
            string.find(lower, "coin") or
            string.find(lower, "drop") or
            string.find(lower, "collect") or
            string.find(lower, "pickup")
         ) then
            -- Fire touch event directly without moving player
            firetouchinterest(hrp, obj, 0) -- touch begin
            task.wait(0.05)
            firetouchinterest(hrp, obj, 1) -- touch end
         end

         -- Also fire proximity prompts for cash-related prompts
         if obj:IsA("ProximityPrompt") and (
            string.find(string.lower(obj.Name), "cash") or
            string.find(string.lower(obj.Name), "collect") or
            string.find(string.lower(obj.Name), "money") or
            string.find(string.lower(obj.ActionText or ""), "collect")
         ) then
            fireproximityprompt(obj)
         end
      end)
   end
end

