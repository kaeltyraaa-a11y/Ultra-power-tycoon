PlayerTab:CreateSection("No Cooldown")

local function hookCooldownMeta()
   if hookedMeta then return end
   hookedMeta = true
   local mt = getrawmetatable and getrawmetatable(game)
   if mt then
      local oldIndex = mt.__newindex
      setreadonly(mt, false)
      mt.__newindex = function(t, k, v)
         if noCooldown and type(k) == "string" and (
            string.find(string.lower(k), "cooldown") or
            string.find(string.lower(k), "cdtime") or
            string.find(string.lower(k), "dashcd") or
            string.find(string.lower(k), "skillcd") or
            string.find(string.lower(k), "timer")
         ) and type(v) == "number" and v > 0 then
            return oldIndex(t, k, 0)
         end
         return oldIndex(t, k, v)
      end
      setreadonly(mt, true)
   end
end

local function scanAndReset(container)
   if not container then return end
   for _, obj in ipairs(container:GetDescendants()) do
      pcall(function()
         if obj:IsA("NumberValue") or obj:IsA("IntValue") or obj:IsA("StringValue") then
            local lower = string.lower(obj.Name)
            if string.find(lower, "cooldown") or
               string.find(lower, "cdtime") or
               string.find(lower, "dashcd") or
               string.find(lower, "skillcd") or
               string.find(lower, "timer") or
               string.find(lower, " cd") then
               if obj:IsA("StringValue") then
                  obj.Value = "0"
               else
                  obj.Value = 0
               end
            end
         end
      end)
   end
end

