MiscTab:CreateSection("Respawn Helper")

local deathPos = nil

local function onDied()
   if character and character:FindFirstChild("HumanoidRootPart") then
      deathPos = character.HumanoidRootPart.Position
   end
end

local function onCharAdded(c)
   character = c
   local hum = c:WaitForChild("Humanoid")
   hum.Died:Connect(onDied)
   if deathPos and Rayfield.Flags.RespawnDeath then
      local hrp = c:WaitForChild("HumanoidRootPart")
      task.wait(0.3)
      hrp.CFrame = CFrame.new(deathPos + Vector3.new(0, 5, 0))
   end
end

player.CharacterAdded:Connect(onCharAdded)
if player.Character then onCharAdded(player.Character) end

MiscTab:CreateToggle({
   Name = "Respawn at Death Position",
   CurrentValue = true,
   Flag = "RespawnDeath",
   Callback = function(val)
      if not val then deathPos = nil end
   end,
})

MiscTab:CreateSection("ESP")

local function clearESP()
   for _, h in pairs(espHighlights) do
      if h then h:Destroy() end
   end
   espHighlights = {}
end

local function applyESP()
   clearESP()
   for _, p in ipairs(Players:GetPlayers()) do
      if p ~= player and p.Character then
         local highlight = Instance.new("Highlight")
         highlight.FillColor        = Color3.fromRGB(255, 50, 50)
         highlight.OutlineColor     = Color3.fromRGB(255, 255, 255)
         highlight.FillTransparency = 0.5
         highlight.Parent           = p.Character
         espHighlights[p.Name]      = highlight
      end
   end
end

MiscTab:CreateToggle({
   Name = "Player ESP",
   CurrentValue = false,
   Flag = "PlayerESP",
   Callback = function(val)
      espActive = val
      if val then
         applyESP()
         Rayfield:Notify({ Title = "ESP", Content = "Player ESP enabled!", Duration = 2 })
      else
         clearESP()
      end
   end,
})

Players.PlayerAdded:Connect(function(p)
   if espActive then
